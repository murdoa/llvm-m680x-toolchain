diff --git a/compiler/rustc_target/src/spec/targets/m6800_none_elf.rs b/compiler/rustc_target/src/spec/targets/m6800_none_elf.rs
new file mode 100644
index 000000000..147070028
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/m6800_none_elf.rs
@@ -0,0 +1,48 @@
+use crate::spec::{
+    Arch, Cc, Endian, LinkerFlavor, Lld, PanicStrategy, RelocModel, Target, TargetMetadata,
+    TargetOptions,
+};
+
+pub(crate) fn target() -> Target {
+    Target {
+        llvm_target: "m6800".into(),
+        metadata: TargetMetadata {
+            description: Some("Motorola 6800 family, for the Hitachi HD6301 (bare metal)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(false),
+        },
+        pointer_width: 16,
+        data_layout: "E-m:e-p:16:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-n8:16-S8".into(),
+        arch: Arch::M6800,
+
+        options: TargetOptions {
+            c_int_width: 16,
+            cpu: "6301".into(),
+            endian: Endian::Big,
+
+            // Link with clang, whose bare-metal driver adds crt0, libc and
+            // the compiler-rt builtins, and runs ld.lld.
+            linker: Some("clang".into()),
+            linker_flavor: LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+            pre_link_args: TargetOptions::link_args(
+                LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+                &["--target=m6800"],
+            ),
+
+            // No atomic instructions, and one thread.
+            max_atomic_width: Some(0),
+            atomic_cas: false,
+
+            panic_strategy: PanicStrategy::Abort,
+            relocation_model: RelocModel::Static,
+            // There is no trap instruction; unreachable code calls abort.
+            trap_unreachable: false,
+            emit_debug_gdb_scripts: false,
+            eh_frame_header: false,
+            // One thread: fences need no instructions.
+            singlethread: true,
+            ..Default::default()
+        },
+    }
+}
