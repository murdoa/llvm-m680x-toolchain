diff --git a/compiler/rustc_target/src/callconv/m6809.rs b/compiler/rustc_target/src/callconv/m6809.rs
new file mode 100644
index 000000000..c6519b825
--- /dev/null
+++ b/compiler/rustc_target/src/callconv/m6809.rs
@@ -0,0 +1,48 @@
+// The C calling convention of the LLVM M6809 and M6800 backends, which
+// share it. Clang's M6809ABIInfo is the reference: aggregates are passed by
+// value in the argument area and returned through a hidden pointer, as
+// LLVM's default ABI does. Zero-sized arguments are already ignored.
+// Integers narrower than `int` (16 bits) are extended.
+
+use rustc_abi::TyAbiInterface;
+
+use crate::callconv::{ArgAbi, FnAbi};
+
+fn classify_ret<Ty>(ret: &mut ArgAbi<'_, Ty>) {
+    if ret.layout.is_aggregate() {
+        ret.make_indirect();
+    } else {
+        ret.extend_integer_width_to(16);
+    }
+}
+
+fn classify_arg<'a, Ty, C>(cx: &C, arg: &mut ArgAbi<'a, Ty>)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+{
+    if arg.layout.pass_indirectly_in_non_rustic_abis(cx) {
+        arg.make_indirect();
+        return;
+    }
+    if arg.layout.is_aggregate() {
+        arg.pass_by_stack_offset(None);
+        return;
+    }
+    arg.extend_integer_width_to(16);
+}
+
+pub(crate) fn compute_abi_info<'a, Ty, C>(cx: &C, fn_abi: &mut FnAbi<'a, Ty>)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+{
+    if !fn_abi.ret.is_ignore() {
+        classify_ret(&mut fn_abi.ret);
+    }
+
+    for arg in fn_abi.args.iter_mut() {
+        if arg.is_ignore() {
+            continue;
+        }
+        classify_arg(cx, arg);
+    }
+}
