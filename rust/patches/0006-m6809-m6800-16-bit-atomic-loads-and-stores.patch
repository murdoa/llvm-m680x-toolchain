From 8d56931831ba47d380fb251ce17e04772ea00425 Mon Sep 17 00:00:00 2001
From: murdoa <murdoa@protonmail.com>
Date: Sun, 25 Oct 2026 18:05:19 +0000
Subject: [PATCH] m6809/m6800: 16-bit atomic loads and stores

The backends now make 8- and 16-bit atomic loads and stores plain
instructions, as on msp430.  There is still no compare-and-swap.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 compiler/rustc_target/src/spec/targets/m6800_none_elf.rs | 5 +++--
 compiler/rustc_target/src/spec/targets/m6809_none_elf.rs | 5 +++--
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/compiler/rustc_target/src/spec/targets/m6800_none_elf.rs b/compiler/rustc_target/src/spec/targets/m6800_none_elf.rs
index 147070028..69df75e12 100644
--- a/compiler/rustc_target/src/spec/targets/m6800_none_elf.rs
+++ b/compiler/rustc_target/src/spec/targets/m6800_none_elf.rs
@@ -30,8 +30,9 @@ pub(crate) fn target() -> Target {
                 &["--target=m6800"],
             ),
 
-            // No atomic instructions, and one thread.
-            max_atomic_width: Some(0),
+            // One CPU: 8- and 16-bit loads and stores are atomic.  There
+            // is no compare-and-swap.
+            max_atomic_width: Some(16),
             atomic_cas: false,
 
             panic_strategy: PanicStrategy::Abort,
diff --git a/compiler/rustc_target/src/spec/targets/m6809_none_elf.rs b/compiler/rustc_target/src/spec/targets/m6809_none_elf.rs
index 28b557432..afc8f1489 100644
--- a/compiler/rustc_target/src/spec/targets/m6809_none_elf.rs
+++ b/compiler/rustc_target/src/spec/targets/m6809_none_elf.rs
@@ -30,8 +30,9 @@ pub(crate) fn target() -> Target {
                 &["--target=m6809"],
             ),
 
-            // No atomic instructions, and one thread.
-            max_atomic_width: Some(0),
+            // One CPU: 8- and 16-bit loads and stores are atomic.  There
+            // is no compare-and-swap.
+            max_atomic_width: Some(16),
             atomic_cas: false,
 
             panic_strategy: PanicStrategy::Abort,
-- 
2.51.2

